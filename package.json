{
  "name": "cf-pump-screener",
  "version": "1.0.0",
  "type": "module",
  "description": "Serverless 24/7 Pump.fun Token Launch Screener & Health Monitor on Cloudflare Free Tier",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test test/screener.test.ts test/helius_parser.test.ts test/d1_binding.test.ts",
    "db:init:local": "wrangler d1 execute pump_launches --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute pump_launches --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.125.0"
  }
}
