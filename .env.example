# CF-Pump-Screener Local Environment Configuration

# Telegram Alert Configuration
# Bot Token from @BotFather (e.g. for @memcoinhome_bot)
TELEGRAM_BOT_TOKEN=

# Your Telegram Numeric Chat ID (e.g. from @userinfobot)
TELEGRAM_CHAT_ID=8528169052

# Set to "false" to enable live Telegram alerts, or "true" to mute
PAUSE_TELEGRAM_ALERTS=false

# Minimum institutional conviction score to trigger Stage 2 alert (0-100)
MIN_ALERT_SCORE=75

# Local Server Port
PORT=8787
HOST=0.0.0.0

# Direct PumpPortal WebSocket Ingestion (true/false)
ENABLE_WS_FEED=true
