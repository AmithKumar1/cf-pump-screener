# CF-Pump-Screener Local Environment Configuration

# Telegram Alert Configuration
# Bot Token from @BotFather (e.g. for @memcoinhome_bot)
TELEGRAM_BOT_TOKEN=

# Your Telegram Numeric Chat ID (e.g. from @userinfobot)
TELEGRAM_CHAT_ID=8528169052

# Set to "false" to enable live Telegram alerts, or "true" to mute
PAUSE_TELEGRAM_ALERTS=false

# Minimum institutional conviction score to trigger Stage 2 alert (0-100)
MIN_ALERT_SCORE=75

# Stage 1 (New Token Birth) Alerts on Telegram
# Set to "false" to mute generic creations on Telegram (keeps your Telegram high-conviction).
# All creations are still saved to SQLite and shown on the Web Dashboard.
ENABLE_STAGE1_TELEGRAM_ALERTS=false

# Minimum Bonding Curve % for Stage 2 Breakout Alert (e.g. 35% curve, ~$27k mcap, ~30 SOL raised)
MIN_BREAKOUT_CURVE_PCT=35

# Minimum 1-hour trading volume in USD to qualify for Breakout alert
MIN_BREAKOUT_VOLUME_USD=10000

# Minimum distinct buy transactions to prove real multi-wallet accumulation
MIN_BREAKOUT_BUYS=25

# Database Retention: Days to keep un-alerted generic events (0 to disable)
RETENTION_DAYS=7

# Local Server Port
PORT=8787
HOST=0.0.0.0

# Direct PumpPortal WebSocket Ingestion (true/false)
ENABLE_WS_FEED=true
